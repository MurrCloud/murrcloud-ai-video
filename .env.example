# Copy to .env, chmod 600, fill dedicated DB/cache/session secrets. No credentials from other applications.
# Optional provider/archive secrets stay empty until separately approved.
# Generate independent URL-safe passwords: python -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=
REDIS_PASSWORD=
VIDEO_SESSION_SECRET=
# Set URLs to match the dedicated passwords above (URL-encode special characters).
VIDEO_DATABASE_URL=postgresql+psycopg://video:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/video_studio
VIDEO_REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
VIDEO_ENVIRONMENT=development
VIDEO_COOKIE_SECURE=false
VIDEO_ALLOWED_ORIGINS=["http://localhost:8100","http://127.0.0.1:8100","http://localhost:3100","http://127.0.0.1:3100"]
VIDEO_RENDER_ENABLED=false
VIDEO_NARRATION_ENABLED=false
VIDEO_TTS_TIMEOUT_SECONDS=60
VIDEO_RENDER_TIMEOUT_SECONDS=3600
VIDEO_RENDER_SCRATCH_MAX_BYTES=134217728
VIDEO_PAID_GENERATION_ENABLED=false
# Keep empty until explicit approval; a nonempty reference alone does not enable jobs.
VIDEO_PAID_APPROVAL_REFERENCE=
VIDEO_FAL_KEY=
# Phase 3 director: no live model is assumed and no calls are enabled by default.
VIDEO_DIRECTOR_ENABLED=false
VIDEO_OPENAI_API_KEY=
# Independent Fernet key for administrator-only encrypted, inactive key staging.
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve privately.
VIDEO_PROVIDER_KEY_ENCRYPTION_KEY=
VIDEO_DIRECTOR_MODEL=
VIDEO_DIRECTOR_APPROVAL_REFERENCE=
VIDEO_DIRECTOR_MAX_OUTPUT_TOKENS=8000
VIDEO_DIRECTOR_TIMEOUT_SECONDS=45
VIDEO_STORYBOARD_DURATION_TOLERANCE_SECONDS=1
VIDEO_MAX_MEDIA_BYTES=536870912
VIDEO_STORAGE_MAX_BYTES=2147483648
VIDEO_STORAGE_MIN_FREE_BYTES=536870912
# Production override requires a pre-existing host signal file and HTTPS origin.
VIDEO_HOST_SIGNAL_FILE=
# Optional private archive adapter; local hot copies remain quota-bound.
VIDEO_S3_ENABLED=false
VIDEO_S3_ENDPOINT_URL=
VIDEO_S3_BUCKET=
VIDEO_S3_REGION=us-east-1
VIDEO_S3_ACCESS_KEY_ID=
VIDEO_S3_SECRET_ACCESS_KEY=
