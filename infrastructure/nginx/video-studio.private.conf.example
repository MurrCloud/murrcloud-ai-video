# REVIEW TEMPLATE ONLY: no public listener, TLS certificate, DNS or ERP change.
# May be staged in a separate private Nginx candidate configuration for validation.
limit_req_zone $binary_remote_addr zone=video_studio_private:1m rate=10r/s;

server {
    listen 127.0.0.1:18100;
    server_name localhost;
    server_tokens off;
    client_max_body_size 16m;
    client_body_timeout 15s;
    send_timeout 30s;

    # Request paths and query strings may contain private project information.
    access_log off;
    error_log /var/log/nginx/video-studio-private.error.log warn;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        limit_req zone=video_studio_private burst=20 nodelay;
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }
}
