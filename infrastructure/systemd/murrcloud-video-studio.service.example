# Install only after Studio-specific filesystem/image/config verification.
# The mount unit is prepared separately; this unit never creates or formats it.
[Unit]
Description=MurrCloud AI Video Studio initial services
Requires=docker.service
After=docker.service
RequiresMountsFor=/srv/video-studio

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/video-studio/current
EnvironmentFile=/opt/video-studio/shared/studio.env
ExecStartPre=/usr/bin/mountpoint -q /srv/video-studio
ExecStartPre=/usr/bin/test -f /srv/video-studio/.studio-filesystem
# Exact addresses only: reject wildcard, CIDR, blank and malformed proxy values.
ExecStartPre=/usr/bin/python3 -c 'import ipaddress, os; values = os.environ.get("VIDEO_TRUSTED_PROXY_IPS", "127.0.0.1").split(","); assert 1 <= len(values) <= 4; [ipaddress.ip_address(value.strip()) for value in values]'
ExecStartPre=/usr/bin/docker compose --project-name murrcloud-video-studio --env-file /opt/video-studio/shared/studio.env --profile ui -f docker-compose.yml -f docker-compose.prod.yml -f infrastructure/docker/compose.vps.yml config --quiet
ExecStart=/usr/bin/docker compose --project-name murrcloud-video-studio --env-file /opt/video-studio/shared/studio.env --profile ui -f docker-compose.yml -f docker-compose.prod.yml -f infrastructure/docker/compose.vps.yml up -d --no-build --pull never --wait --wait-timeout 180 postgres redis api frontend
ExecStop=/usr/bin/docker compose --project-name murrcloud-video-studio --env-file /opt/video-studio/shared/studio.env --profile ui -f docker-compose.yml -f docker-compose.prod.yml -f infrastructure/docker/compose.vps.yml stop --timeout 30 frontend api redis postgres
# Also clean up this project's partial start if up --wait fails; never remove data.
ExecStopPost=-/usr/bin/docker compose --project-name murrcloud-video-studio --env-file /opt/video-studio/shared/studio.env --profile ui -f docker-compose.yml -f docker-compose.prod.yml -f infrastructure/docker/compose.vps.yml stop --timeout 30 frontend api redis postgres
TimeoutStartSec=210
TimeoutStopSec=150
Restart=no

[Install]
WantedBy=multi-user.target
